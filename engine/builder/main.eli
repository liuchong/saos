;; The command line entry point.
;;
;; Options come from argv and go to the shared orchestration. The Action entry
;; point is a different front end over the same code.

(module saos.builder.main
  (import "node:path" :as Path)
  (import "../support/host.eli" truthy?)
  (import "./build.eli" build-workspace default-engine-root)

  (defconst argv (js* "process.argv"))
  (defconst console-error (js* "((message) => { console.error(message); })"))
  (defconst set-exit-code (js* "((code) => { process.exitCode = code; })"))

  (defun option-value (name fallback)
    (let ((index 2)
          (found fallback))
      (while (< index (get argv :length))
        (when (and (= (js-nth index argv) name)
                   (< (+ index 1) (get argv :length)))
          (setq found (js-nth (+ index 1) argv)))
        (setq index (1+ index)))
      found))

  (defun flag? (name)
    (let ((index 2)
          (found false))
      (while (< index (get argv :length))
        (when (= (js-nth index argv) name)
          (setq found t))
        (setq index (1+ index)))
      found))

  (defasync main ()
    (let* ((workspace (Path/resolve (option-value "--workspace" (js* "process.cwd()"))))
           (result (await (build-workspace
                            (js-object
                              :workspace workspace
                              :engineRoot (option-value "--engine-root" (default-engine-root))
                              :content (option-value "--content" "content/blog")
                              :config (option-value "--config" "saos.config.mjs")
                              :public (option-value "--public" "static")
                              :output (option-value "--output" "dist")
                              :base (option-value "--base" "")
                              :modelOut (option-value "--model-out" "")
                              :modelOnly (if (flag? "--model-only") t false))))))
      (if (flag? "--model-only")
          (print (str "SAOS model: " (get result :postCount) " post(s)"))
        (print (str "SAOS built "
                    (get result :postCount)
                    " post(s) into "
                    (Path/relative workspace (get result :outputDir)))))))

  (js-call (main)
           :catch
           (lambda (error)
             (funcall console-error (get error :message "unknown failure"))
             (funcall set-exit-code 1))))
