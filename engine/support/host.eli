;; JavaScript truthiness, for the places the ported logic depends on it.
;;
;; Eliscript truthiness is not JavaScript truthiness: only `false`, `null`, and
;; `undefined` are falsy, so an empty string is truthy here and falsy there.
;; Every step that was originally `x || fallback` or `x ? a : b` must say so
;; explicitly, or the two engines disagree on empty values.

(module saos.support.host
  (defconst boolean-of (js* "((value) => Boolean(value))"))
  (defconst array-check (js* "Array.isArray"))

  (defun truthy? (value) (funcall boolean-of value))

  ;; JavaScript's `||` takes the right side for any falsy left side, and an
  ;; empty string is one of those. Eliscript's `or` does not: only false, null,
  ;; and undefined are falsy here. Every ported `a || b` goes through this.
  (defun or-value (left right) (if (truthy? left) left right))

  ;; `nil?` tests exactly `null`. A property that does not exist reads as
  ;; `undefined`, so the optional-chaining steps of the ported code need both.
  (defun absent? (value) (or (nil? value) (= value (js* "undefined"))))

  (defun array? (value) (funcall array-check value))

  (export truthy? absent? array? or-value))
