{
  "name": "saos",
  "private": true,
  "type": "module",
  "description": "A source-first, self-building React blog for GitHub Actions.",
  "version": "0.0.1",
  "author": "刘冲",
  "bugs": {
    "url": "https://github.com/liuchong/saos/issues"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@fontsource-variable/montserrat": "^5.0.19",
    "@fontsource/merriweather": "^5.0.13",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-prism-plus": "^2.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "eliscript": "0.0.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.3.2"
  },
  "homepage": "https://github.com/liuchong/saos",
  "keywords": [
    "blog",
    "github-action",
    "static-site-generator",
    "vite",
    "react",
    "markdown"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuchong/saos.git"
  },
  "scripts": {
    "build": "node scripts/cli.mjs build --workspace examples/basic",
    "parity": "node tools/parity.mjs",
    "develop": "node scripts/cli.mjs develop --workspace examples/basic",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "npm run develop",
    "serve": "vite preview --host 127.0.0.1",
    "clean": "node scripts/cli.mjs clean --workspace examples/basic",
    "test": "node --test --test-concurrency=1 && npm run format:check"
  }
}
